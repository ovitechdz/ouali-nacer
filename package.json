{
  "name": "ovitech",
  "private": true,
  "version": "0.1.0",
  "description": "OVITECH - Arabic-first, offline-first smart sheep-farm platform",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "check:seed": "node scripts/check-seed.mjs",
    "check:domain": "node scripts/check-domain.mjs",
    "check:origins": "node scripts/audit-external-origins.mjs",
    "audit:bundle": "node scripts/audit-bundle.mjs",
    "audit:precache": "node scripts/audit-precache.mjs",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run check:i18n && npm run check:rtl && npm run check:secrets && npm run check:deps && npm run check:seed && npm run check:domain && npm run build && npm run audit:bundle && npm run audit:precache && npm run check:origins"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.139.0",
    "clsx": "^2.1.1",
    "gsap": "3.15.1",
    "i18next": "^25.7.0",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.3.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.1.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.2.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^3.2.0"
  }
}
